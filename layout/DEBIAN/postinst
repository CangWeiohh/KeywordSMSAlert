#!/bin/sh
#
# KeywordSMSAlert postinst
#
# Runs inside the roothide bootstrap, where "/" is the (randomly named) jailbreak
# root, so these paths are jbroot relative - exactly like the package layout.
#
set -e

# Allow the alert host (SpringBoard, running as mobile) to write the optional log
# file next to the alert sound when LogToFile is enabled.
mkdir -p /Library/KeywordSMSAlert 2>/dev/null || true
chown -R mobile:mobile /Library/KeywordSMSAlert 2>/dev/null || true
chmod 755 /Library/KeywordSMSAlert 2>/dev/null || true
chmod 644 /Library/KeywordSMSAlert/alert.caf 2>/dev/null || true

# Create the configuration once, and never touch it again.
#
# It is deliberately NOT shipped as a dpkg conffile: that is what made every upgrade
# print "Configuration file ... Keeping old config file as default". The tweak has the
# same defaults compiled in, so an absent file behaves identically, and this script
# only writes it when it does not exist yet - your settings are never overwritten by
# an upgrade or by a reinstall.
CONFIG=/var/mobile/Library/Preferences/com.keyword.smsalert.plist
if [ ! -f "$CONFIG" ]; then
	mkdir -p "$(dirname "$CONFIG")" 2>/dev/null || true
	cat > "$CONFIG" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Enabled</key>
	<true/>
	<key>Keywords</key>
	<array>
		<string>验证码</string>
		<string>支付</string>
		<string>重要</string>
		<string>紧急</string>
	</array>
	<key>MatchMode</key>
	<string>contains</string>
	<key>CaseInsensitive</key>
	<true/>
	<key>AlertMode</key>
	<integer>3</integer>
	<key>VibrationEnabled</key>
	<true/>
	<key>VibrationDuration</key>
	<real>5</real>
	<key>VibrationInterval</key>
	<real>0.7</real>
	<key>SoundEnabled</key>
	<true/>
	<key>SoundDuration</key>
	<real>10</real>
	<key>SoundVolume</key>
	<real>0.8</real>
	<key>SoundLoop</key>
	<true/>
	<key>SoundChannel</key>
	<string>alert</string>
	<key>DuplicateInterval</key>
	<real>10</real>
	<key>OnNewMatchedSMS</key>
	<string>restart</string>
	<key>PollInterval</key>
	<real>1</real>
	<key>DebugEnabled</key>
	<false/>
	<key>LogToFile</key>
	<false/>
</dict>
</plist>
PLIST
	chmod 644 "$CONFIG" 2>/dev/null || true
	echo "KeywordSMSAlert: default configuration created."
else
	chmod 644 "$CONFIG" 2>/dev/null || true
	echo "KeywordSMSAlert: existing configuration kept (never overwritten by updates)."
fi

echo "KeywordSMSAlert: installed."
echo "KeywordSMSAlert: configuration: /var/mobile/Library/Preferences/com.keyword.smsalert.plist"
if [ ! -d /Library/PreferenceLoader/Preferences ]; then
	echo "KeywordSMSAlert: NOTE - PreferenceLoader was not found."
	echo "KeywordSMSAlert:   The tweak works without it, but the Settings pane"
	echo "KeywordSMSAlert:   (Settings -> KeywordSMSAlert) needs the 'preferenceloader' package."
fi

# The SMS detector is injected into imagent; restarting that daemon is invisible to
# the user (launchd brings it straight back) and activates the new detector.  The
# alert engine is a standalone launchd job: KeywordSMSAlert never injects SpringBoard.
if command -v killall >/dev/null 2>&1; then
	killall -9 imagent 2>/dev/null || true
	echo "KeywordSMSAlert: imagent restarted (detector reloaded)."
else
	echo "KeywordSMSAlert: restart imagent manually: launchctl kickstart -k system/com.apple.imagent"
fi

# ---------------------------------------------------------------------------
# 1.2.0 cleanup: this package injects nothing into SpringBoard and installs no
# launchd service. Remove every component that earlier versions (or the diagnostic
# builds) may have left behind, so a stale SpringBoard dylib can never survive an
# upgrade - a leftover dylib is exactly what produced the persistent black screen
# on this device.
# ---------------------------------------------------------------------------
for stale in \
	/Library/MobileSubstrate/DynamicLibraries/KeywordSMSAlertAlert.dylib \
	/Library/MobileSubstrate/DynamicLibraries/KeywordSMSAlertAlert.plist \
	/Library/MobileSubstrate/DynamicLibraries/KeywordSMSAlertSpringBoardProbe.dylib \
	/Library/MobileSubstrate/DynamicLibraries/KeywordSMSAlertSpringBoardProbe.plist \
	/Library/LaunchDaemons/com.keyword.smsalert.alertd.plist \
	/usr/libexec/ksaalertd
do
	if [ -e "$stale" ]; then
		rm -f "$stale" 2>/dev/null || true
		echo "KeywordSMSAlert: removed leftover $stale"
	fi
done

if command -v launchctl >/dev/null 2>&1; then
	launchctl bootout system/com.keyword.smsalert.alertd 2>/dev/null || true
fi

echo "KeywordSMSAlert: no SpringBoard injection, no launchd service (imagent only)."
echo "KeywordSMSAlert: settings pane: Settings -> KeywordSMSAlert (needs PreferenceLoader)."
echo "KeywordSMSAlert: use one Dopamine userspace restart after this architecture upgrade."

exit 0
